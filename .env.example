# ============================================================
#  NOVA — your AI voice assistant — SETTINGS
#
#  1) Make a COPY of this file in the same folder.
#  2) Rename the copy to exactly:   .env       (yes, starting with a dot)
#  3) Paste your Claude API key on the line below and save.
#  4) Everything else is OPTIONAL — remove the # in front of a line to use it.
#
#  Full step-by-step help (with pictures) is in the Guide PDF.
# ============================================================

# ---- REQUIRED: your Claude (Anthropic) API key ----
# Get one at https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE


# ---------- Everything below is optional ----------

# ---- The AI brain ----
# NOVA_MODEL=claude-sonnet-4-6     # fast & smart; or claude-opus-4-8 (smartest), claude-haiku-4-5 (cheapest)

# ---- Hearing you (speech-to-text; runs locally & free) ----
# NOVA_WHISPER_MODEL=small         # tiny / base / small — "small" is most accurate for accents
# NOVA_LANGUAGE=                   # blank = auto-detect; or lock to "en", "fr", etc.
# NOVA_MIC=                        # part of a mic name or a number; blank = auto-pick a real mic

# ---- The voice Nova speaks in ----
# NOVA_TTS_ENGINE=edge             # edge = free neural voices (online); sapi = offline Windows voice
# NOVA_TTS_EDGE_VOICE=en-GB-RyanNeural   # or en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural
# NOVA_TTS_EDGE_VOICE_FR=fr-FR-HenriNeural
# NOVA_TTS_EDGE_RATE=              # e.g. +10% to speak faster; blank = natural

# ---- Hands-free voice lock (only answer your enrolled voice) ----
# NOVA_VOICE_THRESHOLD=0.25        # lower = more forgiving about matching your voice

# ---- Safety ----
# NOVA_CONFIRM_SHELL=true          # always ask before Nova runs a command on your PC

# ---- Control Nova from your PHONE ----
# Set a password and Nova becomes reachable from your phone (see the Guide).
# Your own PC window never needs it. BLANK = phone access OFF (PC-only; the safe default).
# Nova can run commands on your PC, so keep this password LONG and PRIVATE.
# NOVA_ACCESS_PASSWORD=choose-a-long-private-password
# NOVA_HOST=                       # leave blank (automatic)

# ---- Weather on the dashboard (no key needed; auto-detects your city) ----
# NOVA_CITY=                       # override the auto-detected city label
# NOVA_LAT=                        # your latitude (with NOVA_LON) to override location
# NOVA_LON=
# NOVA_UNITS=metric                # metric (°C) or imperial (°F)

# ---- Google Calendar, read-only ----
# Google Calendar -> Settings -> your calendar -> "Secret address in iCal format" -> paste the link
# GOOGLE_CALENDAR_ICS=https://calendar.google.com/calendar/ical/.../basic.ics

# ---- YouTube channel stats ----
# Free key: Google Cloud Console -> enable "YouTube Data API v3" -> create an API key
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL=@yourchannel

# ---- Daily spoken briefing ----
# NOVA_BRIEFING_TIME=08:00         # 24-hour HH:MM while Nova is running, or blank to turn off

# ---- Shopify store stats, read-only ----
# SHOPIFY_STORE=your-store.myshopify.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_TOKEN=                   # legacy alternative instead of client id/secret

# ---- Post to Telegram + Discord ----
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=@yourchannel
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_DEFAULT_CHANNEL=general
# DISCORD_WEBHOOK_URL=             # simpler single-channel alternative to a bot

# ---- Outlook / Microsoft 365 email ----
# OUTLOOK_CLIENT_ID=
# OUTLOOK_TENANT_ID=
